  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@opencode-ai/plugin": "^1.18.0",
    "@opencode-ai/sdk": "^1.18.0",
    "ai": "^7.0.58"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.8.0"
  }
}

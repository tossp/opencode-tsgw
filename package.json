{
  "name": "opencode-tsgw",
  "version": "0.1.0",
  "description": "依赖 TSGW 网关模型的 OpenCode 插件扩展包。",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
